{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AIPanelist": {
    "SttServiceType": "Whisper",
    // ChatClient is the only LLM path that streams, and streaming is what makes
    // time-to-first-audio short. "OllamaAspire" still works but generates the whole
    // response before any audio plays.
    "LlmServiceType": "ChatClient",
    "TtsServiceType": "Qwen3-TTS",
    "AudioDeviceServiceType": "PipeWire",
    "AudioPlaybackServiceType": "PipeWire"
  },
  // Endpoint and Model are both left unset on purpose: under the Aspire AppHost they come
  // from the injected "responses" connection string. Set them explicitly to point at an
  // Ollama you run yourself, or to switch provider entirely.
  "ChatClient": {
    "Provider": "Ollama"
  },
  "PipeWire": {
    "DefaultCaptureNode": "bubbles-tab-sink.monitor",
    "OutputSink": "bubbles-tts-sink"
  },
  "TranscriptSearch": {
    "LogDirectory": "./captured-responses/transcripts"
  },
  "ResponseCapture": {
    "Enabled": true,
    "CaptureTextResponses": true,
    "CaptureAudioResponses": true,
    "TextOutputDirectory": "./captured-responses/text",
    "AudioOutputDirectory": "./captured-responses/audio"
  }
}
