{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "API.Services": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AzureVoiceResourceKey": "<Store in secrets>",
  "AzureVoiceEndpoint": "https://bubbles-foundry.cognitiveservices.azure.com/",
  "AzureVoiceRegion": "eastus",
  "AIPanelist": {
    "AudioInputDeviceId": null,
    "TranscriptBufferSeconds": 180,
    "SummaryIntervalSeconds": 45,
    "MaxResponseWords": 150,
    "EnableFillerPhrases": true,
    "FillerPhraseFiles": [],
    "SttServiceType": "Mock",
    "LlmServiceType": "Mock",
    "TtsServiceType": "Mock"
  }
}
