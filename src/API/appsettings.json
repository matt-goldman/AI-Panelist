{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "API.Services": "Debug"
    }
  },
  "AllowedHosts": "*",
  
  // Azure Cognitive Services TTS Configuration
  "AzureVoiceResourceKey": "<Store in secrets or user-secrets>",
  "AzureVoiceRegion": "eastus",
  "AzureVoiceSettings": {
    "VoiceName": "en-AU-WilliamNeural"
  },
  
  // Ollama LLM Configuration
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "gpt-oss:20b"//"llama3:8b" //"llama2"
  },
  
  // Whisper STT Configuration
  "Whisper": {
    "ModelPath": null
  },
  
  // AI Panelist Configuration
  "AIPanelist": {
    "AudioInputDeviceId": null,
    "TranscriptBufferSeconds": 180,
    "SummaryIntervalSeconds": 45,
    "MaxResponseWords": 150,
    "EnableFillerPhrases": true,
    "FillerPhraseFiles": [],
    
    // Service implementation selection
    // Options: "Mock", "Whisper", "Azure" for STT
    // Options: "Mock", "Ollama", "FoundryLocal" for LLM
    // Options: "Mock", "Azure", "Qwen3-TTS" for TTS
    // Options: "Mock", "Windows" for AudioDevice and AudioPlayback
    "SttServiceType": "Mock",
    "LlmServiceType": "Mock",
    "TtsServiceType": "Mock",
    "AudioDeviceServiceType": "Mock",
    "AudioPlaybackServiceType": "Mock"
  }
}
