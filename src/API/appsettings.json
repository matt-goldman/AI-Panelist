{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "API.Services": "Debug"
    }
  },
  "AllowedHosts": "*",
  
  // Azure Cognitive Services TTS Configuration
  "AzureVoiceResourceKey": "<Store in secrets or user-secrets>",
  "AzureVoiceRegion": "eastus",
  "AzureVoiceSettings": {
    "VoiceName": "en-AU-WilliamNeural"
  },
  
  // Ollama LLM Configuration
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "gpt-oss:20b" //"llama3:8b" //"llama2"
  },

  "FoundryLocal": {
    "Model": "gpt-oss-20b-cuda-gpu" //"llama3-8b" //"llama2"
  },
  
  // Whisper STT Configuration
  "Whisper": {
    "ModelPath": null
  },

  // PipeWire (Linux) audio routing. Node names come from `pactl list short sources|sinks`
  // (column 2) and are created by scripts/bubbles-audio.sh. Indexes are NOT stable
  // across reboots, names are.
  "PipeWire": {
    // Monitor of the sink the StreamYard tab plays into - this is where the remote hosts live.
    "DefaultCaptureNode": null,
    // Null sink whose monitor is remapped into the "Bubbles Mic" virtual source.
    // Leave null and TTS comes out of your speakers instead of going to StreamYard.
    // NOTE: with this set you will NOT hear Bubbles on this machine - its voice goes to the
    // virtual mic only. That is correct. Use "./bubbles-audio.sh monitor on" to hear it.
    "OutputSink": null,
    // The remapped source Bubbles' voice ends up on, measured to confirm the stream would
    // hear it. Created by bubbles-audio.sh; audio is never played to it directly.
    "VirtualMicSource": "bubbles-mic",
    "CaptureLatency": "50ms",
    "PlaybackLatency": "50ms",
    "IncludeMonitorSources": true,
    "AutoRestartCapture": true,
    "CaptureRestartDelayMs": 1000
  },
  
  // AI Panelist Configuration
  "AIPanelist": {
    "AudioInputDeviceId": null,
    "TranscriptBufferSeconds": 180,
    "SummaryIntervalSeconds": 45,
    "MaxResponseWords": 150,
    "EnableFillerPhrases": true,
    "FillerPhraseFiles": [],
    
    // Service implementation selection
    // Options: "Mock", "Whisper", "Azure" for STT
    // Options: "Mock", "Ollama", "FoundryLocal", "OllamaAspire" for LLM
    // Options: "Mock", "Azure", "Qwen3-TTS" for TTS
    // Options: "Mock", "Windows", "PipeWire" for AudioDevice and AudioPlayback
    //   - "Windows" uses NAudio (WASAPI/WinMM) and only runs on Windows
    //   - "PipeWire" uses pw-cat/pactl and is the Linux path (see scripts/bubbles-audio.sh)
    "SttServiceType": "Mock",
    "LlmServiceType": "Mock",
    "TtsServiceType": "Mock",
    "AudioDeviceServiceType": "Mock",
    "AudioPlaybackServiceType": "Mock"
  },

  // Runtime-selected LLM via Microsoft.Extensions.AI. Set AIPanelist:LlmServiceType to
  // "ChatClient" to use this. Only this path streams, and streaming is what makes
  // time-to-first-audio short.
  // Provider: "Ollama" | "OpenAI" (or any OpenAI-compatible endpoint) | "AzureAIInference"
  // Put ApiKey in user-secrets, never here.
  "ChatClient": {
    "Provider": "Ollama",
    "Model": "qwen3.8:latest",
    "Endpoint": "http://localhost:11434",
    "ApiKey": null,

    // Summaries can run somewhere else entirely. One model on one GPU means a summary
    // mid-flight owns the card while a trigger waits behind it; a second box on the LAN,
    // or a smaller model, removes that contention rather than mitigating it.
    // Anything left unset falls back to the settings above. All unset = one client, as before.
    "Summary": {
      "Provider": "OpenAI",
      "Model": "unsloth/Qwen3.8-27B-GGUF:Q4_K_M",
      "Endpoint": "https://llama.gfg.homes/v1",
      "ApiKey": null
    }
  },

  // Streamed responses: flush to TTS at clause boundaries while the model is still writing,
  // and queue chunk N+1 while N plays. Disable to fall back to the proven
  // generate-everything-then-speak path (which also restores the filler phrases).
  "StreamingResponse": {
    "Enabled": true,
    // The opening chunk sets time-to-first-audio, so it is kept short - but not so short
    // that it comes out prosodically flat.
    "FirstChunkMinChars": 20,
    "FirstChunkMaxChars": 110,
    // Later chunks can be longer; playback of the previous chunk is buying time.
    "MinChunkChars": 80,
    "MaxChunkChars": 320,
    "SynthesisLookahead": 2
  },

  // The setup app at /setup: pre-flight checks, live input meters, and the handful of
  // audio-graph fixes it can apply itself. The API has no authentication, so only allow
  // the actions on a network you control.
  "Setup": {
    "AllowAudioGraphActions": true,
    // Left null, scripts/bubbles-audio.sh is found by walking up from the content root.
    "AudioScriptPath": null
  },

  // Publish how loud Bubbles' speech is, frame by frame, so a display can drive a mouth
  // from the real audio instead of a canned animation. Tiny messages; a display that
  // doesn't understand them ignores them.
  "SpeechEnvelope": {
    "Enabled": true,
    "FrameMs": 50,
    // dBFS mapped to a closed and a fully open mouth. Speech peaks well below 0dB.
    "FloorDb": -45,
    "CeilingDb": -8,
    // How far the audible audio lags the queued audio - roughly PipeWire's playback
    // latency plus pw-cat's buffer. Raise it if the mouth runs ahead of the sound,
    // lower it if it lags. Tune by watching, not by calculation.
    "OutputLatencyMs": 120
  },

  // Never go silent. If a response produces nothing speakable - reasoning ate the whole
  // budget, the LLM errored, or no answer text arrived for too long - say a canned line
  // instead. Recorded WAVs in wwwroot/audio/fallback-phrases take precedence over these
  // lines, which are synthesised once at startup and cached.
  "SilenceGuard": {
    "Enabled": true,
    // Longest wait on the model for answer text (time spent playing audio doesn't count).
    // 0 disables the timer but keeps the empty-answer and error fallbacks.
    "MaxSilenceSeconds": 25,
    "Lines": [],
    "SynthesisTimeoutSeconds": 10
  },

  // Answer off the cuff (reasoning off, first token in well under a second) unless the
  // model replies with the marker and a short holding line, which is spoken while a second
  // pass with reasoning on produces the real answer. Needs LlmServiceType "ChatClient" with
  // streaming; reasoning on/off is sent as Ollama's "think" option.
  "ResponseTriage": {
    // On by default: without it every answer runs with the model's full, unbounded
    // reasoning, which is what produced silent responses and 10-20s waits in testing.
    "Enabled": true,
    "Marker": "[THINK]",
    // How long the thinking pass may reason before it's abandoned for a quick no-reasoning
    // answer. Keep below SilenceGuard:MaxSilenceSeconds.
    "ThinkingTimeoutSeconds": 15,
    // Reasoning + answer budget for the thinking pass; the timeout normally bites first.
    "ThinkingMaxOutputTokens": 3000
  },

  // Stop Whisper inventing text during the quiet stretches of a panel. Given silence it
  // reliably produces "Thank you.", "[BLANK_AUDIO]", or fragments of its own prompt.
  "Transcription": {
    // Audio quieter than this RMS is never sent to Whisper.
    "SilenceRmsThreshold": 0.005,
    // Drop "[BLANK_AUDIO]", "[ Silence ]", "(music)" and punctuation-only results.
    "DropNonSpeechArtefacts": true
  },

  // Self-suppression: stop Bubbles transcribing its own voice after it comes back
  // around through StreamYard's mix. Gates the transcript, never the capture node.
  "SelfSuppression": {
    "Enabled": true,
    // Extra suppression after playback ends, covering audio still in flight
    // through StreamYard and back into the captured tab. 200-500ms is the useful range.
    "TailMs": 350,
    // Leftover audio shorter than this is not sent to Whisper - short fragments
    // produce hallucinated text rather than useful transcript.
    "MinimumSegmentSeconds": 1.0,
    "HistorySeconds": 120
  },

  // Spoken trigger phrases: say one and Bubbles answers, exactly as if the moderator
  // button had been pressed. The button stays as the silent fallback. Runs a second Whisper
  // worker per capture device on a short rolling window, so a phrase fires within ~1s of being
  // said rather than 5-10s (the transcript loop's cadence).
  "TriggerPhrases": {
    "Enabled": true,
    // Matched as whole words, case and punctuation ignored. Anchor each on "Bubbles" plus a
    // direction word so third-person mentions don't fire. Empty uses the built-in set.
    "Phrases": [
      "what do you think bubbles",
      "over to you bubbles",
      "your take bubbles",
      "how about you bubbles",
      "care to weigh in bubbles",
      "give us your view bubbles",
      "bubbles jump in here",
      "take it away bubbles"
    ],
    // Capture devices (name or ID) to listen on. Empty = all selected devices. In person,
    // set this to the moderator's mic only.
    "Devices": [],
    "WindowMs": 5000,
    "HopMs": 1000,
    "MinimumSeconds": 1.0,
    "CooldownMs": 4000
  },

  // Let Bubbles look up something said earlier in the panel via a tool call. Keyword
  // search, not embeddings. Needs LlmServiceType "ChatClient". Each search adds a model
  // round trip before the first audio. Check what a search would find with
  // GET /api/panelist/transcript/search?q=...
  "TranscriptSearch": {
    "Enabled": false,
    // Write the whole session transcript here as JSON lines (one file per run). Null = memory only.
    "LogDirectory": null,
    "MaxResults": 5,
    "ContextEntries": 1,
    "MaxSearchesPerResponse": 1
  },

  // Response Capture Configuration (for recording LLM responses and TTS audio)
  "ResponseCapture": {
    "Enabled": false,
    "CaptureTextResponses": true,
    "CaptureAudioResponses": true,
    "TextOutputDirectory": "./captured-responses/text",
    "AudioOutputDirectory": "./captured-responses/audio"
  }
}
