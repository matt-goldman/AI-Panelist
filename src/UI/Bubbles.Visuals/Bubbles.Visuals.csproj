<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Microsoft.Maui.Graphics alone, deliberately: no Controls, no SkiaSharp, no platform
    head. That is what lets the same drawing run in the MAUI app and in the GTK app, which
    registers no SkiaSharp handler and so cannot use the SkiaSharp visuals at all.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
