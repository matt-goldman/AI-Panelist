<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="ModeratorApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:ModeratorApp"
       xmlns:pages="clr-namespace:ModeratorApp.Pages;assembly=ModeratorApp"
       Title="AI Panelist Moderator">

    <TabBar>
        <ShellContent Title="Moderation"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate local:ModerationPage}"
                      Route="moderation" />

        <ShellContent Title="Devices"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate pages:DevicesPage}"
                      Route="devices" />
    </TabBar>

</Shell>
