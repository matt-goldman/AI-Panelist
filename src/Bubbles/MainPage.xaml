<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Bubbles.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             Background="{DynamicResource BeerBackground}">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <skia:SKConfettiView x:Name="BubbleConfetti"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill" />

        <skia:SKLottieView x:Name="BubblesState"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           WidthRequest="650"
                           HeightRequest="650"
                           RepeatCount="-1" />

        <!--
            The mouth, driven by the loudness of the audio being played. Hidden unless the
            speaking animation is set to "meter": by default the Lottie artwork stays and
            pulses with the voice instead. Same drawing as the GTK display.
        -->
        <GraphicsView x:Name="MouthView"
                      IsVisible="False"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="650"
                      HeightRequest="650" />

        <Image Margin="20"
               Source="bdd_logo.png"
               WidthRequest="400"
               HorizontalOptions="Start"
               VerticalOptions="Start" />
    </Grid>

</ContentPage>
