{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },

  // Qwen3-TTS server. WorkingDirectory and VenvPath are left at their defaults
  // (../../src/QwenAPI and .venv), which are already correct.
  //
  // RefAudio overrides server.py's default of ~/qwentts/bubbles-sample.wav, which is a
  // leftover from the Windows setup. The sample actually lives beside server.py.
  //
  // RefText is deliberately NOT set: server.py's built-in default is the correct
  // transcript for this sample, and env vars override the file rather than merge with it.
  "QwenTts": {
    "RefAudio": "/mnt/data/repos/AI-Panelist/src/QwenAPI/bubbles-sample.wav"
  }
}
